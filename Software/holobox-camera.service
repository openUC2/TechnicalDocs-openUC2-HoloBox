[Unit]
Description=HoloBox Camera API Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/Software
Environment=PATH=/home/pi/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 streamlined_camera_api.py --host 0.0.0.0 --port 80 --no-ssl
Restart=always
RestartSec=5

# Allow binding to port 80 without root
# Run this once: sudo setcap 'cap_net_bind_service=+ep' /usr/bin/python3
# Or use authbind as alternative

[Install]
WantedBy=multi-user.target